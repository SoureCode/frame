{
  "name": "@sourecode/frame",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/frame.umd.cjs",
  "module": "./dist/frame.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/frame.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/frame.js",
      "require": "./dist/frame.umd.cjs"
    },
    "./styles": "./dist/frame.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --ui-host=0.0.0.0 --ui-port=8080"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jsdom": "^29.1.0",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1"
  }
}
